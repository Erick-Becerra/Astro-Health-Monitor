  "systems": {
    "heart": {
      "label": "Cardiovascular",
      "description": "Heart and blood pressure: weightlessness redistributes fluids and strains the cardiovascular system.",
      "hardware": "Bio-Monitor shirt (ECG) + oscillometric sphygmomanometer",
      "physiology": "In microgravity blood shifts toward the upper body and the heart works under a different load. Heart rate, blood pressure and heart rate variability are tracked against the pre-flight baseline."
    },
    "lungs": {
      "label": "Respiratory",
      "description": "Oxygenation, breathing and cabin air quality.",
      "hardware": "Pulse oximeter + cabin CO₂ sensor",
      "physiology": "In a closed environment CO₂ builds up easily. An alert is raised from 2.3 mmHg and 3.0 mmHg is the limit; headaches usually appear before reaching it."
    },
    "brain": {
      "label": "Central nervous system / Brain",
      "description": "Sleep, cognitive performance and behavioral health (PHQ-9 and GAD-7 questionnaires).",
      "hardware": "Actiwatch actigraph + PVT-B test + digital psychometric questionnaires",
      "physiology": "Short sleep impairs reflexes (PVT-B test) and increases stress. Isolation and confinement also weigh on mood, so the questionnaires are repeated and PHQ-9 Item 9 is watched."
    },
    "metabolism": {
      "label": "Endocrine / Metabolism",
      "description": "Blood glucose and metabolism.",
      "hardware": "Capillary glucometer",
      "physiology": "Stress, the flight diet and exercise change how glucose is handled. The measurement is read in context: fasting or after eating."
    },
    "thermal": {
      "label": "Thermoregulation / Immunity",
      "description": "Core body temperature.",
      "hardware": "Dual forehead sensor",
      "physiology": "Without natural convection the body dissipates heat poorly. A sustained rise in temperature may indicate infection or thermal fatigue, and it must be judged according to activity."
    },
    "radiation": {
      "label": "Whole body / Radiation",
      "description": "Radiation dose received and career budget.",
      "hardware": "Active RAD / Liulin dosimeter",
      "physiology": "Outside Earth's protection the dose accumulates. The daily rate, the percentage of the agency's career limit and solar particle events are tracked."
    },
    "bones": {
      "label": "Bone and muscle",
      "description": "Bone density and adherence to resistive exercise.",
      "hardware": "DXA densitometry (on Earth) + ARED device",
      "physiology": "Without mechanical load bone is lost continuously. Resistive exercise (ARED) is the main countermeasure."
    },
    "eyes": {
      "label": "Eyes (SANS)",
      "description": "Head and vision symptoms associated with spaceflight neuro-ocular syndrome.",
      "hardware": "Ocular tomography (OCT, on Earth) + crew reports",
      "physiology": "The shift of fluids toward the head can alter the eye. Reports of headache or blurred vision are followed closely."
    }
  },

