# Optional. Copy this file to ".env" only if you want to change a default.
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro
POSTGRES_DB=astro_health

# Address of the space station server the frontend reads from. It changes when the
# hotspot restarts, so keep it here and never in the code. Default: http://localhost:8001
# VITE_STATION_URL=http://172.20.10.2:8001
# Name shown in the station change log when this screen writes something.
# VITE_ACTOR=Your name
